# Copy this file to ".env" and fill the values.

PORT=5000

# Local MongoDB:   mongodb://127.0.0.1:27017/campusconnect
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect

# Any long random text. Never share it.
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call this API (comma separated).
# For testing on a phone you can use * (allow all).
CORS_ORIGIN=*

# Walking route service (free, OpenStreetMap based). Keep as it is.
ROUTING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot

# Campus centre (used as a default map centre). Knowledge Park II, Greater Noida.
CAMPUS_LAT=28.4572
CAMPUS_LNG=77.4972

# The user who signs up with THIS email becomes admin automatically.
# Put your own email here, then sign up in the app with the same email.
ADMIN_EMAIL=your-email@example.com
